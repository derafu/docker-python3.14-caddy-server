sites/
docker-compose.override.yml
config/ssh/authorized_keys
config/ssh/id_rsa
config/ssh/id_rsa.pub
.env
.DS_Store

# Per-site Caddy routes generated by scripts/start_procfile_supervisord.sh
# from CADDY_ROUTE_PATH (land here on the host because config/caddy is
# bind-mounted to /etc/caddy). Keep the directory itself (.gitkeep) so a
# fresh clone has it ready for Caddy's `import`, but not the generated
# per-site files.
config/caddy/routes.d/*
!config/caddy/routes.d/.gitkeep
