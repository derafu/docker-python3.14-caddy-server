#
# Environment variables for local development.
#
# The variables are used in the `docker-compose.yml` file to configure the
# docker container.
#
# Copy this file to `.env` and modify the variables as needed.
#

# Caddy configuration.
CADDY_DEBUG=debug
CADDY_EMAIL=admin@example.com

# Port mapping for local development.
HTTP_PORT=8080
HTTPS_PORT=8443
SSH_PORT=2222
MANAGER_PORT=9090

# Hostname of the deployer server to connect to when deploying a site.
DEPLOYER_HOST=

# Optional: build PHP (--enable-embed) and phpy (https://github.com/swoole/phpy)
# so Python can host PHP code (e.g. derafu/backbone-bridge-python). Disabled
# by default: building PHP from source adds several minutes to the image
# build. Set to "true" and rebuild (`docker compose build`) to enable it.
PHPY_ENABLED=false
PHPY_PHP_VERSION=8.5.12
# SHA-256 of php-<version>.tar.gz (php.net/releases); change it with the version.
PHPY_PHP_SHA256=81a0f450349e84b08eb43faa85f8a4c835684f3cc1c50471775d1317a046c525
# phpy commit to build.
PHPY_REF=6629eec8b95e99843498c59bc1d9294315847f48
