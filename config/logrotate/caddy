/var/log/caddy/*.log {
    # Rotate logs weekly.
    weekly
    # Do not show an error if the file does not exist.
    missingok
    # Keep the last 8 logs.
    rotate 8
    # Compress old logs.
    compress
    # Compress them one cycle after rotation.
    delaycompress
    # Do not rotate if empty.
    notifempty
    # Only run post-rotation scripts once.
    sharedscripts
    # Add su directive to avoid permission issues.
    su admin admin
    postrotate
        systemctl reload caddy > /dev/null 2>&1 || true
    endscript
}
